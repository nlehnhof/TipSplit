# ------------------------------------------------------------------
# TipSplit environment variables
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# ------------------------------------------------------------------

# Supabase (project URL + anon key are safe for the browser; service role
# key is server-only and must NEVER be exposed to the client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys from the Stripe dashboard).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=

# Public origin of the app. Used for magic-link redirects and canonical
# URLs. e.g. http://localhost:3001 locally, https://<your-app>.vercel.app in prod.
NEXT_PUBLIC_APP_URL=
